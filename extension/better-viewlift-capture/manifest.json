{
  "manifest_version": 3,
  "name": "ViewLift Helper",
  "version": "1.0.2",
  "description": "ViewLift productivity helper with automatic CMS tab capture and future workflow tools.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["tabs"],
  "host_permissions": [
    "https://cms.viewlift.com/*",
    "https://cms-gcp.viewlift.com/*",
    "https://cms-qcp.viewlift.com/*",
    "https://cms.monumentalsportsnetwork.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cms.viewlift.com/*",
        "https://cms-gcp.viewlift.com/*",
        "https://cms-qcp.viewlift.com/*",
        "https://cms.monumentalsportsnetwork.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
